{
  "expo": {
    "name": "DailyKhata",
    "slug": "dailykhata",
    "version": "1.12.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailykhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dailykhata.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.dailykhata.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A34A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DailyKhata to attach photos from your library to entries.",
          "cameraPermission": "Allow DailyKhata to take photos to attach to entries."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DailyKhata to use Face ID to unlock the app."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "798fb15b-cae8-4126-ae04-5e91c2380be9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/798fb15b-cae8-4126-ae04-5e91c2380be9"
    }
  }
}
