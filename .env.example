# DailyKhata — Supabase cloud sync
#
# Copy this file to `.env` and fill in the values, then restart the dev server.
# Without a filled-in `.env` the app runs fully offline (no sign-in, no sync);
# the manual backup/restore features stay available in Settings → Advanced.
#
# Setup steps:
#   1. Create a free project at https://supabase.com
#   2. Enable Phone authentication + an SMS provider (e.g. Twilio) in
#      Authentication → Providers → Phone.
#   3. Run the SQL in `supabase/migrations/001_initial.sql` (and
#      002_realtime.sql for live multi-device sync) in the SQL editor.
#   4. Copy the Project URL and anon (public) key from Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Google Sign-In (see docs/13-supabase-setup.md → "Google Sign-In").
# Only the web client ID is required; the Android / iOS IDs are used by their
# matching platforms. Omit them all to hide the Google button.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
